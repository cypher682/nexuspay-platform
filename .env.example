NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Raised above the default (20) so local k6 load tests are not throttled.
# Keep this low in production.
AUTH_RATE_LIMIT_MAX_REQUESTS=5000

# General (non-auth) rate limit; raised so k6 payment load tests are not
# throttled. Keep tight (~100) in production.
RATE_LIMIT_MAX_REQUESTS=5000

# Gateway downstream timeout. 5s avoids tripping the circuit breaker on load
# spikes; keep lower (~2s) in production for fast failover.
DOWNSTREAM_TIMEOUT_MS=5000

JWT_SECRET=change-me-at-least-32-characters-long-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MFA_ISSUER=NexusPay

# 10 rounds in dev/test keeps bcrypt cheap enough for concurrency load tests;
# keep 12+ in production.
BCRYPT_ROUNDS=10

# libuv threadpool size. bcrypt (async) + Prisma + Redis compete for these
# threads; 4 (default) saturates under concurrent auth load. Raise in prod
# workers too (min(8, cores*2)).
UV_THREADPOOL_SIZE=8

PROVIDER_WEBHOOK_SECRET=change-me-provider-webhook-secret
INTERNAL_API_KEY=change-me-internal-api-key

SMTP_URL=smtp://localhost:1025
SMTP_FROM=NexusPay <no-reply@nexuspay.local>
SMS_PROVIDER=mock
