NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-at-least-32-characters-long-secret
AUTH_ISSUER=NexusPay

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

INTERNAL_API_KEY=change-me-internal-api-key
AUTH_SERVICE_URL=http://localhost:4001
PAYMENTS_SERVICE_URL=http://localhost:4002
NOTIFICATIONS_SERVICE_URL=http://localhost:4003
DOWNSTREAM_TIMEOUT_MS=2000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_SECONDS=15
