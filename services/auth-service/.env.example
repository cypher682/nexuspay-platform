NODE_ENV=development
PORT=4001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://nexuspay:nexuspay@localhost:5433/nexuspay_auth?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MFA_CHALLENGE_TTL_MINUTES=5
MFA_ISSUER=NexusPay

BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TTL_SECONDS=900
