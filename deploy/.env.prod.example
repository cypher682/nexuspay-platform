# NexusPay — production environment for /opt/apps/nexuspay/.env (chmod 600)
#
# This file documents the variables the production compose file expects.
# Copy it to the server, replace every CHANGE_ME with `openssl rand -hex 32`
# (or `openssl rand -base64 48`), then chmod 600 .env.
#
#   ssh deploy@141.148.69.94
#   install -m 600 /dev/null /opt/apps/nexuspay/.env
#   $EDITOR /opt/apps/nexuspay/.env
#
# Never commit the real .env. This example contains no secrets.

NODE_ENV=production
LOG_LEVEL=info

# Public entrypoint (gateway) and browser origin allowed by CORS.
PUBLIC_BASE_URL=https://nexuspay.141-148-69-94.sslip.io
CORS_ORIGIN=https://nexuspay.141-148-69-94.sslip.io

# --- Secrets (CHANGE_ME) ---
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
PROVIDER_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32
INTERNAL_API_KEY=CHANGE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
RABBITMQ_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# --- Database / broker identities (non-secret usernames) ---
POSTGRES_USER=nexuspay
RABBITMQ_USER=nexuspay

# --- Tokens / crypto ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MFA_ISSUER=NexusPay
BCRYPT_ROUNDS=12
UV_THREADPOOL_SIZE=8

# --- Rate limits / timeouts tuned for a public demo (not a load test) ---
AUTH_RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_MAX_REQUESTS=300
DOWNSTREAM_TIMEOUT_MS=2000

# --- Providers (mock, no external calls) ---
PROVIDER_SUCCESS_RATE=0.9
SMS_PROVIDER=mock
SMTP_FROM=NexusPay <no-reply@nexuspay.local>

# --- Observability ---
# No Jaeger/Prometheus in the core stack; keep trace export off and metrics on.
OTEL_TRACES_ENABLED=false
METRICS_ENABLED=true
